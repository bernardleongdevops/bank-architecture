<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>sg.edu.rp.sandbox</groupId>
        <artifactId>digital-bank-sandbox</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ai-assistant-service</artifactId>
    <name>ai-assistant-service</name>
    <description>Agentic banking chatbot: relays conversations to OpenAI and executes grounded, owner-scoped tools via the gateway</description>

    <properties>
        <!--
          jqwik pinned below 1.10.0 on purpose. jqwik 1.10.0 (2026-05-25) was reported
          to ship a payload aimed at AI coding agents; 1.9.3 is the last known-good
          release before that and is a stable JUnit 5 platform property-testing engine.
        -->
        <jqwik.version>1.9.3</jqwik.version>
    </properties>

    <dependencies>
        <!-- Internal modules, consistent with the other services. -->
        <dependency>
            <groupId>sg.edu.rp.sandbox</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>sg.edu.rp.sandbox</groupId>
            <artifactId>security-adapters</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Resource-server JWT validation (Keycloak), reused from security-adapters. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!--
          NOTE: this service has NO datasource. No JPA/JDBC starter is declared and
          DataSourceAutoConfiguration is excluded on the application class, so the
          context starts without a database.
        -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Property-based testing on the JUnit 5 platform. -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${jqwik.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
              Ensure Surefire runs BOTH the JUnit Jupiter engine (unit/web-slice tests)
              and the jqwik engine (property tests). The JUnit Platform auto-detects
              engines on the classpath, so no explicit <includes> are needed.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*Properties.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
